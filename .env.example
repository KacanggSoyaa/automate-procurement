GEMINI_API_KEY=your_api_key_here
# Optional: override the model (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- Alternative AI providers (pick one with AI_PROVIDER) ---
# AI_PROVIDER=gemini            # gemini | openai | anthropic
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-6-luna
# ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Login system (admin-created accounts) ---
# Signing secret for session cookies AND the key used to encrypt stored AI API
# keys at rest. Set a long random string in production. Changing it signs out
# every session and makes existing saved API keys unreadable (users re-enter
# them in Settings). If omitted, a random key is generated once and stored in
# data/auth_secret.key.
# AUTH_SECRET=change_me_to_a_long_random_string
# How long a session lasts, in days (default 7, max 90).
# SESSION_DAYS=7
# Password policy (default 8, minimum 8).
# PASSWORD_MIN_LENGTH=8

# Browser origins allowed to call the API with credentials (comma-separated).
# Wildcards are ignored because credentialed CORS requires explicit origins.
# Defaults to the Vite dev server; the app's own origin is always allowed.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Session cookie flags. COOKIE_SECURE auto-detects HTTPS when unset.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=strict

# Upload limits (per file / per request / file count / Office zip expansion).
# MAX_UPLOAD_FILE_MB=100
# MAX_UPLOAD_TOTAL_MB=250
# MAX_UPLOAD_FILES=100
# MAX_UPLOAD_ZIP_MB=500
# MAX_UPLOAD_ZIP_RATIO=200

# Optional first-admin bootstrap: created automatically on first startup when
# no users exist yet. Prefer the CLI (python -m server.auth add-user --admin).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me
