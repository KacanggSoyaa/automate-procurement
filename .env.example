GEMINI_API_KEY=your_api_key_here
# Optional: override the model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# --- Login system (admin-created accounts) ---
# Signing secret for session cookies. Set a long random string in production.
# If omitted, a random key is generated once and stored in data/auth_secret.key.
# AUTH_SECRET=change_me_to_a_long_random_string
# How long a session lasts, in days (default 7).
# SESSION_DAYS=7

# Optional first-admin bootstrap: created automatically on first startup when
# no users exist yet. Prefer the CLI (python -m server.auth add-user --admin).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me
